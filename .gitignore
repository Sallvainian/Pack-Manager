# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment files (the documented template remains tracked)
.env
.env.*
!.env.example

# Playwright output
playwright-report/
test-results/
blob-report/

